<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OpenTaskbar</AssemblyName>
    <RootNamespace>OpenTaskbar</RootNamespace>
    <Version>0.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tmp/**/*.cs" />
    <InternalsVisibleTo Include="OpenTaskbar.Tests" />
    <EmbeddedResource Include="themes\**\*.*" LogicalName="OpenTaskbar.BuiltInThemes/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Localization\Languages\*.json" LogicalName="OpenTaskbar.Localization.Languages.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Localization\Flags\*.png" LogicalName="OpenTaskbar.Localization.Flags.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
